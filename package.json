{
  "name": "healthcare-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Hands-On Diet",
  "type": "module",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "predev:worker": "set CI=true&& drizzle-kit generate && npm run build && wrangler d1 migrations apply healthcare-mcp --local",
    "dev:worker": "wrangler dev",
    "build": "skybridge build",
    "start": "skybridge start",
    "predeploy": "set CI=true&& drizzle-kit generate && npm run build && wrangler d1 migrations apply healthcare-mcp --remote",
    "deploy": "wrangler deploy",
    "deploy:alpic": "alpic deploy",
    "evals": "vitest run evals",
    "evals:types": "tsc --noEmit -p tsconfig.evals.json",
    "seed:training-docs": "node scripts/seed-training-docs.mjs --upload-r2 --apply-remote",
    "seed:training-docs:local": "node scripts/seed-training-docs.mjs --apply-local"
  },
  "dependencies": {
    "@alpic-ai/ui": "^1.155.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.10.1",
    "skybridge": "^2.1.1",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@skybridge/devtools": "^2.1.1",
    "@skybridge/test": "^2.1.1",
    "@skybridge/vite-plugin": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ai": "^7.0.0",
    "alpic": "^1.155.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
